# JARVIS LLM Configuration
# Copy this file to .env and fill in your values

# Provider Selection: "ollama" or "nvidia"
# Default: auto-detect from config (NVIDIA key present -> nvidia, else -> ollama)
AI_PROVIDER=

# Fallback Configuration (optional)
# AI_PRIMARY_PROVIDER=
# AI_FALLBACK_PROVIDER=
# AI_AUTO_FAILOVER=false

# NVIDIA NIM Configuration
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Ollama (local) - default provider
OLLAMA_ENDPOINT=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=qwen2.5:7b-instruct-q3_K_M
